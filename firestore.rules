rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // المستخدم لازم يكون مسجل دخول.
    function signedIn() {
      return request.auth != null;
    }

    // التحقق من أن صاحب الطلب Admin.
    // يعتمد على users/{uid}.role = "admin".
    function isAdmin() {
      return signedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    match /users/{userId} {

      // المستخدم يقدر يقرأ بياناته فقط، والـ Admin يقدر يقرأ كل المستخدمين.
      allow read: if signedIn() && (request.auth.uid == userId || isAdmin());

      // المستخدم ينشئ مستند حسابه بنفس UID.
      // ممنوع إنشاء حساب يضع role = admin من الواجهة.
      allow create: if signedIn()
        && request.auth.uid == userId
        && (
          !request.resource.data.keys().hasAny(['role'])
          || request.resource.data.role != 'admin'
        );

      // المستخدم يعدل بياناته فقط، مع منع تغيير/إضافة role إلى admin.
      // الـ Admin يملك صلاحية الإدارة الكاملة على مستندات المستخدمين.
      allow update: if isAdmin()
        || (
          signedIn()
          && request.auth.uid == userId
          && (
            !request.resource.data.keys().hasAny(['role'])
            || (
              resource.data.keys().hasAny(['role'])
              && request.resource.data.role == resource.data.role
            )
          )
        );

      // حذف بيانات المستخدم من الواجهة غير مسموح للمستخدم العادي.
      // الـ Admin فقط يستطيع الحذف.
      allow delete: if isAdmin();
    }

    // أي Collection أخرى تظل مغلقة افتراضيًا إلى أن نضيف لها
    // صلاحيات محددة مع ربطها بالوظيفة المطلوبة.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
