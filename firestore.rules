rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn(){ return request.auth != null; }
    function isOwner(uid){ return isSignedIn() && request.auth.uid == uid; }
    function isAdmin(){
      return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.active == true;
    }
    match /admins/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if false;
    }
    match /users/{uid} {
      allow read, write: if isOwner(uid) || isAdmin();
      match /{document=**} {
        allow read, write: if isOwner(uid) || isAdmin();
      }
    }
    match /appSettings/{doc} { allow read: if true; allow write: if isAdmin(); }
    match /publicContent/{doc} { allow read: if true; allow write: if isAdmin(); }
    match /{document=**} { allow read, write: if isAdmin(); }
  }
}
