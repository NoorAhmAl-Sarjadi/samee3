/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  X-Frame-Options: DENY
  Content-Security-Policy: default-src 'self'; img-src 'self' data: blob:; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self' mailto: https://wa.me https://api.whatsapp.com; upgrade-insecure-requests

/
  Cache-Control: no-store, max-age=0
/index.html
  Cache-Control: no-store, max-age=0
/js/*
  Cache-Control: no-store, max-age=0
/styles.css
  Cache-Control: no-store, max-age=0
